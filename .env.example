# .env にコピーして使う（.env は git に含めない）

# Gemini API キー（https://aistudio.google.com/apikey で発行）
# 設定すると、Wikipedia をもとにした記事・問題の生成、要約の採点、単語の意味調べが有効になる
GEMINI_API_KEY=

# 使うモデル（省略時 gemini-3.8-flash）
# GEMINI_MODEL=gemini-3.8-flash

# YouTube Data API v3 のキー（Google Cloud Console で発行）
# Gemini と両方設定すると、リスニングが実際のニュース動画になる
YOUTUBE_API_KEY=

# セッション用の秘密鍵（省略時は instance/secret_key を自動生成）
# SECRET_KEY=

# スマホから同じ Wi-Fi で開くときは 0.0.0.0 にする
# HOST=0.0.0.0
# PORT=5000
